{
  "expo": {
    "name": "Transporte Urbano",
    "slug": "transporte-urbano-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1565C0"
    },
    "android": {
      "package": "com.transporteurbano.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "TU_API_KEY_DE_GOOGLE_MAPS"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.transporteurbano.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrar la posición del bus en tiempo real."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite que la app use tu ubicación para el seguimiento del bus."
        }
      ]
    ]
  }
}
