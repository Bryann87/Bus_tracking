{
  "expo": {
    "name": "Transporte Urbano",
    "slug": "transporte-urbano-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "transporteurbano",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1565C0"
    },
    "android": {
      "package": "com.transporteurbano.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1565C0"
      },
      "config": {
        "googleMaps": {
          "apiKey": "TU_API_KEY_DE_GOOGLE_MAPS_ANDROID"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.transporteurbano.app",
      "buildNumber": "1.0.0",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Transporte Urbano necesita tu ubicación en segundo plano para transmitir la posición del bus a los pasajeros.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "config": {
        "googleMapsApiKey": "TU_API_KEY_DE_GOOGLE_MAPS_IOS"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Transporte Urbano necesita tu ubicación en segundo plano para transmitir la posición del bus a los pasajeros.",
          "locationWhenInUsePermission": "Transporte Urbano necesita tu ubicación para mostrar la posición del bus en el mapa.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "731c1dbd-55ff-49e7-bf06-093b9254ff0d"
      }
    }
  }
}
